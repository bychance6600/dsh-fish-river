{
  "name": "dsh-fish-river",
  "version": "0.1.57",
  "description": "养一条会自己长大的鱼：没有人格设置，人格只能通过事件流长出来；她会自己刷 B 站，也能在 QQ、B 站私信（抖音可选）里说话，并记住在外面遇到的人。四个阶段完成后才开始有立场。状态库在 ~/.dsh-fish-river，不能删除记录。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib",
    "media",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "bin",
    "tools/setup-ffmpeg.mjs",
    "tools",
    "install.ps1"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "unknown",
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "unknown",
        "0.2.1-rc.5": "unknown",
        "0.2.2-alpha.2": "unknown"
      },
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "pet",
    "qq",
    "bilibili",
    "douyin",
    "memory",
    "persona"
  ],
  "author": "ssamurias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssamurias/dsh-fish.git"
  },
  "homepage": "https://github.com/ssamurias/dsh-fish#readme",
  "bugs": {
    "url": "https://github.com/ssamurias/dsh-fish-river/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {}
}
